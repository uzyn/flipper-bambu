# Manifest for the ufbt build path (`make ufbt`).
#
# The fbt path does not read this file: `make copy-plugin` injects an equivalent
# App() entry into the firmware's own applications/main/nfc/application.fam.
# Keep the two entries in sync.

# Stub manifest for the parent NFC app. It is NOT built and NOT deployed.
#
# ufbt has no firmware tree, so the PLUGIN entry below cannot resolve its
# `requires=["nfc"]` parent: fbt_extapps.py looks the id up via AppManager.get(),
# which raises "Missing application manifest for 'nfc'" rather than returning
# None. Declaring the parent here satisfies that lookup. apptype=APP (rather
# than PLUGIN/EXTERNAL/MENUEXTERNAL) keeps it out of ufbt's external-app build
# list, so ufbt registers it as a parent but never tries to build it.
#
# Removing this entry breaks `ufbt`. Dropping `requires` instead does not work
# either — ufbt rejects a PLUGIN with no `requires`.
App(
    appid="nfc",
    name="NFC",
    apptype=FlipperAppType.APP,
    targets=["f7"],
)

App(
    appid="bambu_parser",
    apptype=FlipperAppType.PLUGIN,
    entry_point="bambu_plugin_ep",
    targets=["f7"],
    requires=["nfc"],
    sources=["plugin/bambu.c"],
    fap_version="1.1",
)
